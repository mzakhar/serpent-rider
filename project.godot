; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Serpent Rider"
config/description="Dragon Breed-inspired side-scrolling shooter"
run/main_scene="res://scenes/levels/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoloads/event_bus.gd"
GameManager="*res://autoloads/game_manager.gd"
ScoreManager="*res://autoloads/score_manager.gd"

[display]

window/size/viewport_width=512
window/size/viewport_height=364
window/size/mode=2
window/stretch/mode="viewport"
window/stretch/aspect="expand"

